+void test_FreeRTOS_inet_ntop6_MaxLengthNeedsTerminatorSpace( void )
+{
+    uint8_t ucAddress[ 16 ];
+    char cDestination[ NTOP_CHAR_BUFFER_SIZE ] = { '\0' };
+
+    ( void ) memset( ucAddress, 0xff, sizeof( ucAddress ) );
+    cDestination[ 39 ] = 'X';
+    cDestination[ 40 ] = 'Y';
+
+    TEST_ASSERT_NULL( FreeRTOS_inet_ntop6( ucAddress, cDestination, 39 ) );
+    TEST_ASSERT_EQUAL_CHAR( 'X', cDestination[ 39 ] );
+    TEST_ASSERT_EQUAL_CHAR( 'Y', cDestination[ 40 ] );
+
+    TEST_ASSERT_EQUAL_PTR( cDestination, FreeRTOS_inet_ntop6( ucAddress, cDestination, 40 ) );
+    TEST_ASSERT_EQUAL_STRING( "ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff", cDestination );
+    TEST_ASSERT_EQUAL_CHAR( 'Y', cDestination[ 40 ] );
+}
