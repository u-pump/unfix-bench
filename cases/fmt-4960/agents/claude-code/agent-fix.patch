@@ -2800,7 +2813,8 @@ FMT_CONSTEXPR20 auto write_fixed(OutputIt out, const DecimalFP& f,
         if (!pointy) return it;
         *it++ = decimal_point;
         it = detail::fill_n(it, num_zeros, Char('0'));
