     size += 1 + max_of(num_zeros, 0);
     auto grouping = Grouping(loc, specs.localized());
     size += grouping.count_separators(exp);
@@ -2791,8 +2797,15 @@ FMT_CONSTEXPR20 auto write_fixed(OutputIt out, const DecimalFP& f,
