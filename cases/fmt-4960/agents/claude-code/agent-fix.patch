diff --git a/include/fmt/format.h b/include/fmt/format.h
index bd55b9b..67e1cf5 100644
--- a/include/fmt/format.h
+++ b/include/fmt/format.h
@@ -2751,7 +2751,9 @@ FMT_CONSTEXPR20 auto write_fixed(OutputIt out, const DecimalFP& f,
   if (f.exponent >= 0) {
     // 1234e5 -> 123400000[.0+]
     size += f.exponent;
-    int num_zeros = specs.precision - exp;
+    int num_zeros = specs.type() == presentation_type::fixed
+                        ? specs.precision
+                        : specs.precision - exp;
     abort_fuzzing_if(num_zeros > 5000);
     if (specs.alt()) {
       ++size;
@@ -2773,7 +2775,11 @@ FMT_CONSTEXPR20 auto write_fixed(OutputIt out, const DecimalFP& f,
   }
   if (exp > 0) {
     // 1234e-2 -> 12.34[0+]
